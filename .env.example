# OpenAI-compatible provider
OPENAI_API_KEY=
PIX_API_BASE=https://api.openai.com/v1
PIX_MODEL=gpt-4o-mini
PIX_API_TOKEN=

# Runtime behavior
PIX_WORKSPACE=.
PIX_MAX_ITERATIONS=30
PIX_SHELL_TIMEOUT=60
PIX_TOOL_TIMEOUT=60
PIX_MAX_FILE_BYTES=200000
PIX_CONTEXT_LIMIT_TOKENS=64000
PIX_AUTO_COMMIT=false
PIX_LOG_LEVEL=INFO

# Storage
PIX_DATABASE_URL=sqlite:///./pix-agent.db

# Optional integrations
PIX_ENABLE_MCP=false
PIX_MCP_SERVERS=[]
PIX_SKILLS_DIR=./skills
PIX_EMBEDDING_MODEL=text-embedding-3-small
